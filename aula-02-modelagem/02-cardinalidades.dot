// Aula 02 - Modelagem de Dados (2026-03-02)
// Exemplos de cardinalidade dos slides:
//   1:1  PESSOA - R - CASA
//   1:N  DEPARTAMENTO - Possui - EMPREGADO
//   N:N  EMPREGADO - CONSULTA - DEPARTAMENTOS (vira tabela intermediaria)

digraph DER {
  graph [splines=curved, nodesep=0.9, ranksep=1.0, bgcolor=white,
         fontname="Helvetica", pad=0.25, outputorder=edgesfirst];
  node  [shape=box, style="filled,rounded", fillcolor="#fbfbfb",
         color="#4a6fa5", fontname="Helvetica", fontsize=11, penwidth=1.2];
  edge  [fontname="Helvetica", fontsize=10, color="#4a6fa5", penwidth=1.2, arrowsize=0.8];

  subgraph cluster_1 {
    label="1:1";
    fontname="Helvetica"; fontsize=11; color="#888888"; style=dashed;
    pessoa1 [label=PESSOA];
    casa    [label=CASA];
    r       [label=R, shape=diamond, fillcolor="#eef2f8", height=0.4, width=0.9];
    pessoa1 -> r [xlabel="1.1", dir=none];
    r -> casa [xlabel="1.1", dir=none];
  }

  subgraph cluster_2 {
    label="1:N";
    fontname="Helvetica"; fontsize=11; color="#888888"; style=dashed;
    departamento [label=DEPARTAMENTO];
    empregado    [label=EMPREGADO];
    possui       [label=Possui, shape=diamond, fillcolor="#eef2f8", height=0.4, width=1.1];
    departamento -> possui [xlabel="1.1", dir=none];
    possui -> empregado [xlabel="1.N", dir=none];
  }

  subgraph cluster_3 {
    label="N:N";
    fontname="Helvetica"; fontsize=11; color="#888888"; style=dashed;
    empregados   [label=EMPREGADO];
    departamentos [label=DEPARTAMENTOS];
    consulta     [label=CONSULTA, shape=diamond, fillcolor="#eef2f8", height=0.4, width=1.2];
    empregados -> consulta [xlabel="0.N", dir=none];
    consulta -> departamentos [xlabel="0.N", dir=none];
  }

  { rank=same; pessoa1; casa }
  { rank=same; departamento; empregado }
  { rank=same; empregados; departamentos }
}
